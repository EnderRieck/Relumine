OCRFORGE_WEB_LLM_API_KEY=replace-with-your-deepseek-key
OCRFORGE_WEB_LLM_BASE_URL=https://api.deepseek.com
OCRFORGE_WEB_LLM_MODEL=deepseek-v4-flash
# OCRFORGE_WEB_CBDB_PATH=/absolute/path/to/cbdb.sqlite3
OCRFORGE_WEB_CHGIS_API_URL=https://chgis.hudci.org/tgaz/placename

# --- Agent chat sidebar (智能助手) ---
# Override the model the agent uses if the default lacks function-calling support.
# OCRFORGE_WEB_AGENT_MODEL=deepseek-chat
# Brave Search API key — enables the web_search tool (https://brave.com/search/api/).
# OCRFORGE_WEB_BRAVE_API_KEY=replace-with-your-brave-search-key
# Headless-browser (Playwright) tool toggle; requires `playwright install chromium`.
# OCRFORGE_WEB_AGENT_ENABLE_BROWSER=true
